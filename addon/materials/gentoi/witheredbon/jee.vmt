"UnlitGeneric"
{
	"$basetexture" "gentoi/witheredbon/jee"
	"$nolod" 1
	"$vertexalpha" 1
	"$vertexcolor" 1
	"$smooth" 1
	"Proxies"
	{
			"AnimatedTexture"
			{
				"animatedTextureVar" "$basetexture"
				"animatedTextureFrameNumVar" "$frame"
				"animatedTextureFrameRate" "12"
			}
	}
}
